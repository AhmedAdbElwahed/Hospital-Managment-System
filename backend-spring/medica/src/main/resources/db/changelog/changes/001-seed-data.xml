    <changeSet id="000-seed-roles" author="gemini-cli">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="role"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM role</sqlCheck>
        </preConditions>
        <insert tableName="role">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="ROLE_ADMIN"/>
        </insert>
        <insert tableName="role">
            <column name="id" valueNumeric="2"/>
            <column name="name" value="ROLE_DOCTOR"/>
        </insert>
        <insert tableName="role">
            <column name="id" valueNumeric="3"/>
            <column name="name" value="ROLE_PATIENT"/>
        </insert>
        <insert tableName="role">
            <column name="id" valueNumeric="4"/>
            <column name="name" value="ROLE_USER"/>
        </insert>
    </changeSet>

    <changeSet id="000-seed-admin" author="gemini-cli">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="user"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM "user" WHERE email = 'admin@gmail.com'</sqlCheck>
        </preConditions>
        <insert tableName="user">
            <column name="id" valueNumeric="1"/>
            <column name="firstname" value="Super"/>
            <column name="lastname" value="User"/>
            <column name="email" value="admin@gmail.com"/>
            <!-- password is 'ChangeMe' encoded with BCrypt -->
            <column name="password" value="$2a$10$9GvR76L8N6.Y/XWz9Jp5X.uYI9zU6z9z9z9z9z9z9z9z9z9z9z9z9"/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="users_roles">
            <column name="user_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="1"/>
        </insert>
    </changeSet>

